DATABASE_URL="postgresql://app:app@localhost:5432/app"
AUTH_SECRET="replace-with-a-long-random-string"
# Cookie Secure flag: leave unset to follow NEXT_PUBLIC_SITE_URL (https → true, http → false)
# COOKIE_SECURE="true"
# On the server set this to https://farolabsystem.com. A localhost value is ignored in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Cal.com / cal.id booking link for /schedule-meeting (leave empty until ready)
NEXT_PUBLIC_CAL_URL=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Blog image uploads. The bucket stays private; the site serves /media/blog/...
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-southeast-2"
AWS_S3_BUCKET="farolabsystems"

# Optional. When these are empty the contact form still saves the lead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="inquiry@example.com"
SMTP_SECURE="false"

# GA4 numeric property ID from Admin → Property settings. Not the G- measurement ID.
# The service account JSON stays in secrets/ga.json and is not committed.
GA_PROPERTY_ID=""
GA_CREDENTIALS_PATH="secrets/ga.json"

# Gemini. The admin Generate button and four posts a day at 08:00, 13:00, 17:00 and 21:00.
# Cover images need billing enabled on the Google project. Text works on the free quota.
GEMINI_API_KEY=""
GEMINI_PROJECT=""
GEMINI_TEXT_MODEL="gemini-2.5-flash"
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
# Protects POST /api/cron/daily-blog
CRON_SECRET=""
BLOG_CRON_TZ="Asia/Kolkata"
